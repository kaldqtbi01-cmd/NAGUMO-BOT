{
  "name": "fits-api",
  "version": "0.2.0",
  "description": "Fast Implemented TikTok Scraping API",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/KinglyShade/fits-api"
  },
  "bugs": {
    "url": "https://github.com/KinglyShade/fits-api/issues"
  },
  "homepage": "https://github.com/KinglyShade/fits-api#readme",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "ts-node-dev src/index.ts",
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "jest",
    "tests": "jest --detectOpenHandles",
    "check-env": "node scripts/check-env.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "tiktok",
    "scraping",
    "sdk",
    "api",
    "crawler",
    "unofficial"
  ],
  "author": "KinglyShade (KinglyFenixStudios)",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.8",
    "cheerio": "^1.0.0-rc.12",
    "jsdom": "^26.1.0",
    "node-fetch": "^3.3.2",
    "playwright": "^1.42.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.12.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.4.5"
  }
}
